[Unit]
Description=Among Us friend-code verification Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nept/au-verify
EnvironmentFile=/home/nept/au-verify/.env
ExecStart=/home/nept/au-verify/.venv/bin/python bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
