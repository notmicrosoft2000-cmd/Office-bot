# Discord application token (https://discord.com/developers/applications)
DISCORD_TOKEN=put-your-bot-token-here

# Guild to sync slash commands to (instant sync). Leave blank for global (slow) sync.
GUILD_ID=

# SQLite file
DB_PATH=data/au_verify.db

# Hours the reminder schedule runs over (halfway nudge, then the final one).
# Nobody is kicked for taking longer — the bot just keeps nudging.
GATE_HOURS=48

# After the final reminder, how often to nudge unverified members again
REMINDER_REPEAT_HOURS=12

# What happens when someone who chose "I don't play Among Us" submits a code:
# ban | flag | off
LIE_PUNISHMENT=ban

# Friend-code validation regex (override if Innersloth changes the format)
# FC_PATTERN=^[A-Za-z0-9_]{1,16}#\d{4}$|^\d{9,10}$

LOG_LEVEL=INFO

# --- Watchdog (deploy/watchdog.py, run by the systemd timer) --------------
# systemd unit to check. Must match `systemctl --user is-active <name>`.
# WATCHDOG_SERVICE=au-verify
# A heartbeat older than this many seconds counts as down.
# WATCHDOG_STALE_SECONDS=600
# Preferred alert target: a Discord channel webhook. This keeps working even if
# the bot token is rotated. Without it, alerts use DISCORD_TOKEN and the log
# channel stored in the database.
# WATCHDOG_WEBHOOK_URL=
# Set to 1 to restart the service when it looks down or hung.
# WATCHDOG_RESTART=0
